#!/usr/bin/env python3
"""hstrack - tiny Hearthstone tracker with a remaining-deck overlay. Follows Power.log, stdlib only."""
import argparse, base64, glob, hashlib, json, os, queue, re, sys, textwrap, threading, time, urllib.request
from collections import Counter

CARDS_URL = "https://api.hearthstonejson.com/v1/latest/enUS/cards.json"
CACHE_DIR = os.path.expanduser("~/.cache/hstrack")
DB_CACHE = os.path.join(CACHE_DIR, "cards2.json")
DECK_CACHE = os.path.join(CACHE_DIR, "last_deck.txt")
LEARN_CACHE = os.path.join(CACHE_DIR, "learned.json")
IMG_DIR = os.path.join(CACHE_DIR, "img")
IMG_URL = "https://art.hearthstonejson.com/v1/render/latest/enUS/256x/{id}.png"
NAME_W = 17
LOG_CONFIG = """[Power]
LogLevel=1
FilePrinting=true
ConsolePrinting=false
ScreenPrinting=false
Verbose=true
"""

PWR = re.compile(r"GameState\.DebugPrintPower\(\) - (.*)$")
BRACKET = re.compile(r"\[entityName=(.*?) id=(\d+) zone=(\w+) zonePos=\d+ cardId=(\w*) player=(\d+)\]")
FULL = re.compile(r"FULL_ENTITY - Creating ID=(\d+) CardID=(\w*)")
SHOW = re.compile(r"(?:SHOW|CHANGE)_ENTITY - Updating Entity=(.+) CardID=(\w*)$")
CHANGE = re.compile(r"(?:TAG_CHANGE|HIDE_ENTITY -) Entity=(.+) tag=(\w+) value=(\w+)$")
TAG = re.compile(r"tag=(\w+) value=(\w+)$")
GTYPE = re.compile(r"GameType=(\w+)")
PLAYER = re.compile(r"PlayerID=(\d+), PlayerName=(.*)$")


def norm(s):
    return s.lower().replace("\u2019", "'")


# ---------------------------------------------------------------- log parsing
class Game:
    def __init__(self):
        self.reset()

    def reset(self):
        self.ents, self.me, self.turn, self.cur = {}, None, 0, None
        self.mode, self.players = "", {}

    def ent(self, eid):
        return self.ents.setdefault(eid, dict(card="", name="", zone=None, ctrl=None,
                                              left_deck=False, played=False,
                                              init=self.turn == 0))

    def ref(self, text):
        m = BRACKET.search(text)
        if m:
            e = self.ent(int(m[2]))
            if e["zone"] is None: e["zone"] = m[3]
            if e["ctrl"] is None: e["ctrl"] = int(m[5])
            if m[4] and not e["card"]: e["card"] = m[4]
            if not m[1].startswith("UNKNOWN"): e["name"] = m[1]
            return e
        return self.ent(int(text)) if text.isdigit() else None

    def tag(self, e, tag, val):
        if tag == "CONTROLLER" and val.isdigit():
            e["ctrl"] = int(val)
        elif tag == "ZONE":
            old, e["zone"] = e["zone"], val
            if val == "DECK": e["left_deck"] = False
            elif old == "DECK": e["left_deck"] = True
            if old in ("HAND", "DECK") and val in ("PLAY", "SECRET", "GRAVEYARD"):
                e["played"] = True

    def feed(self, line):
        """Process one log line; True if the tracked state may have changed."""
        if "GameState.DebugPrintGame" in line:
            s = line.split(" - ", 1)[-1].strip()
            if (m := GTYPE.match(s)):
                self.mode = m[1]; return True
            if (m := PLAYER.match(s)):
                # the opponent is "UNKNOWN HUMAN PLAYER" in your own log -> the other id is you
                self.players[int(m[1])] = m[2].strip()
                hidden = [p for p, n in self.players.items() if n.startswith("UNKNOWN")]
                if len(self.players) == 2 and len(hidden) == 1: self.me = 3 - hidden[0]
                return True
            return False
        if "GameState.DebugPrintPower" not in line: return False
        m = PWR.search(line)
        if not m: return False
        s = m[1].strip()
        if s == "CREATE_GAME":
            self.reset(); return True
        if s.startswith(("GameEntity", "Player ")):
            self.cur = None; return False
        if (m := FULL.match(s)):
            e = self.ent(int(m[1])); e["card"] = m[2]; self.cur = e
            return True
        if (m := SHOW.match(s)):
            e = self.ref(m[1]); self.cur = e
            if e is None: return False
            if m[2]:
                # first reveal of a deck card = our own draw -> that controller is us
                if self.me is None and e["zone"] == "DECK" and not e["card"] and e["ctrl"]:
                    self.me = e["ctrl"]
                if m[2] != e["card"]: e["card"], e["name"] = m[2], ""
            return True
        if (m := CHANGE.match(s)):
            self.cur = None
            if m[1] in ("GameEntity", "1"):
                if m[2] == "TURN": self.turn = int(m[3]); return True
                return False
            e = self.ref(m[1])
            if e is None: return False
            self.tag(e, m[2], m[3]); return True
        if (m := TAG.match(s)) and self.cur is not None:
            self.tag(self.cur, m[1], m[2]); return True
        self.cur = None
        return False


class Follower:
    """Finds the newest Power.log and feeds new lines to a Game."""
    def __init__(self, a, prefix):
        self.a, self.prefix, self.g = a, prefix, Game()
        self.f, self.path, self.checked, self.msg = None, "", 0.0, ""

    def poll(self):
        if self.a.log: want = self.a.log
        elif time.time() - self.checked > 5: want, self.checked = find_log(self.prefix), time.time()
        else: want = self.path
        changed = False
        if want != self.path:
            if self.f: self.f.close()
            self.path = want
            try: self.f = open(want, encoding="utf-8", errors="replace") if want else None
            except OSError as ex: sys.exit(f"cannot open {want}: {ex}")
            self.g.reset()
            changed = True
            self.msg = "" if want else (f"waiting for Power.log under {self.prefix}\n"
                                        "(run --setup once, then start Hearthstone)")
        while self.f:
            pos = self.f.tell()
            line = self.f.readline()
            if not line.endswith("\n"):   # EOF or half-written line
                self.f.seek(pos); break
            changed |= self.g.feed(line)
        return changed


def find_log(prefix):
    base = os.path.join(prefix, "drive_c/Program Files*/Hearthstone/Logs")
    hits = glob.glob(base + "/*/Power.log") + glob.glob(base + "/Power.log")
    return max(hits, key=os.path.getmtime) if hits else None


def setup(prefix):
    blizz = glob.glob(os.path.join(prefix, "drive_c/users/*/AppData/Local/Blizzard"))
    d = os.path.join(blizz[0] if blizz else os.path.join(
        prefix, "drive_c/users", os.environ.get("USER", "user"), "AppData/Local/Blizzard"), "Hearthstone")
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "log.config")
    old = open(p, encoding="utf-8").read() if os.path.exists(p) else ""
    if "[Power]" in old:
        print(p, "already has a [Power] section"); return
    with open(p, "a", encoding="utf-8") as f: f.write(("\n" if old else "") + LOG_CONFIG)
    print("wrote", p, "- restart Hearthstone for it to take effect")


# ---------------------------------------------------------------- cards + decks
def load_db():
    """{cardId: [name, cost, dbfId, collectible]}, downloaded once from HearthstoneJSON."""
    try:
        with open(DB_CACHE, encoding="utf-8") as f: return json.load(f)
    except (OSError, ValueError):
        pass
    try:
        req = urllib.request.Request(CARDS_URL, headers={"User-Agent": "hstrack"})
        with urllib.request.urlopen(req, timeout=30) as r: cards = json.load(r)
        db = {c["id"]: [c["name"], c.get("cost"), c.get("dbfId"), int(bool(c.get("collectible")))]
              for c in cards if "name" in c}
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(DB_CACHE, "w", encoding="utf-8") as f: json.dump(db, f)
        return db
    except Exception as ex:
        print(f"no card database ({ex}); deck codes won't work and costs are unknown", file=sys.stderr)
        return {}


def decode_deckstring(code):
    """Hearthstone deck code -> {dbfId: copies}."""
    data = base64.b64decode(code + "=" * (-len(code) % 4))
    pos = 0

    def varint():
        nonlocal pos
        shift = res = 0
        while True:
            b = data[pos]; pos += 1
            res |= (b & 0x7F) << shift
            if not b & 0x80: return res
            shift += 7

    if varint() != 0: raise ValueError("bad reserved byte")
    varint(); varint()                      # version, format
    for _ in range(varint()): varint()      # heroes
    cards = {}
    for copies in (1, 2):
        for _ in range(varint()): cards[varint()] = copies
    for _ in range(varint()):
        dbf = varint(); cards[dbf] = varint()
    return cards


def entry(name, n, cost=None, ids=(), exact=False):
    return {"name": name, "n": n, "cost": cost, "ids": set(ids), "exact": exact}


def parse_deck(text, db):
    """Deck code (Hearthstone's copy-deck button) or lines like '2 Fireball' -> {key: entry}."""
    by_name = {}                                       # name -> (cost, a card id for its picture)
    for cid, (nm, cost, dbf, col) in db.items():
        if norm(nm) not in by_name or col: by_name[norm(nm)] = (cost, cid)
    deck = {}

    def add(name, n, cost=None, cid=None):
        k = norm(name)
        bcost, bid = by_name.get(k, (None, None))
        d = deck.setdefault(k, entry(name, 0, cost if cost is not None else bcost, exact=True))
        d["n"] += n
        if cid or bid: d["ids"].add(cid or bid)

    lines = [ln.strip() for ln in text.splitlines()]
    code = next((ln for ln in lines if re.fullmatch(r"[A-Za-z0-9+/]{20,}={0,2}", ln)), None)
    if code:
        if not db: raise ValueError("deck codes need the card database (no internet?)")
        by_dbf = {v[2]: (cid, v) for cid, v in db.items() if v[2] is not None}
        try: cards = decode_deckstring(code)
        except Exception: raise ValueError("couldn't decode that deck code")
        for dbf, n in cards.items():
            if dbf in by_dbf:
                cid, v = by_dbf[dbf]
                add(v[0], n, v[1], cid)
    else:
        for ln in lines:
            if not ln: continue
            m = re.match(r"#\s*(\d+)x\s*\(\d+\)\s*(.+)$", ln)      # "# 2x (1) Fireball" from copied decks
            if m: add(m[2].strip(), int(m[1])); continue
            if ln.startswith("#"): continue
            m = re.match(r"(\d+)\s*x?\s+(.+)$", ln)
            if m: add(m[2].strip(), int(m[1]))
            else: add(ln, 1)
    if not deck: raise ValueError("no cards found in that text")
    return deck


def save_deck(text):
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(DECK_CACHE, "w", encoding="utf-8") as f: f.write(text)


def load_learned():
    try:
        with open(LEARN_CACHE, encoding="utf-8") as f: return json.load(f)
    except (OSError, ValueError):
        return {}


def save_learned(data):
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(LEARN_CACHE, "w", encoding="utf-8") as f: json.dump(data, f)


# ---------------------------------------------------------------- arena deck (from Arena.log)
def read_arena(path):
    """-> (card ids of the latest draft-deck listing, Counter of draft picks since the draft began)."""
    ids, picks = [], Counter()
    try: f = open(path, encoding="utf-8", errors="replace")
    except OSError: return ids, picks
    with f:
        for ln in f:
            if "Draft Deck ID" in ln: ids = []
            elif "Draft deck contains card" in ln:
                m = re.search(r"contains card (\w+)", ln)
                if m and m[1] not in ids: ids.append(m[1])
            elif "DraftManager.OnBegin" in ln: picks = Counter()
            elif "Client chooses:" in ln:
                m = re.search(r"\((\w+)\)\s*$", ln.strip())
                if m: picks[m[1]] += 1
    return ids, picks


class ArenaSource:
    """Arena deck from the Arena.log beside the current Power.log (else the newest older session with one).
    Arena.log lists each distinct card once, so copy counts start from your draft picks and get
    corrected as copies show up in games (see summary())."""
    def __init__(self, db):
        self.db, self.memo = db, {}

    def get(self, power_log):
        if not power_log: return None
        d = os.path.dirname(power_log)
        older = sorted((p for p in glob.glob(os.path.join(os.path.dirname(d), "Hearthstone_*")) if p < d), reverse=True)
        for folder in [d] + older[:8]:
            p = os.path.join(folder, "Arena.log")
            try: mt = os.path.getmtime(p)
            except OSError: continue
            if self.memo.get(p, (None,))[0] != mt: self.memo[p] = (mt, read_arena(p))
            ids, picks = self.memo[p][1]
            if ids:
                deck = {}
                for cid in ids:
                    rec = self.db.get(cid)
                    name = rec[0] if rec else cid
                    e = deck.setdefault(norm(name), entry(name, 0, rec[1] if rec else None))
                    e["n"] += max(picks.get(cid, 0), 1)
                    e["ids"].add(cid)
                return deck, hashlib.md5(",".join(sorted(ids)).encode()).hexdigest()[:12]
        return None


def choose_deck(g, state, arena, path):
    """Arena games use the deck from Arena.log; everything else uses the deck you pasted."""
    if "ARENA" in g.mode.upper():
        got = arena.get(path)
        if got: return got[0], "arena", state["learned"].setdefault(got[1], {})
        return {}, "arena (no deck yet)", {}
    return state["deck"], "pasted", {}


# ---------------------------------------------------------------- card pictures
class Images:
    """Card renders from HearthstoneJSON, cached in ~/.cache/hstrack/img and fetched in a background thread."""
    def __init__(self, url):
        self.url, self.state, self.q = url, {}, queue.Queue()
        threading.Thread(target=self._work, daemon=True).start()

    def path(self, cid):
        return os.path.join(IMG_DIR, cid + ".png")

    def want(self, cid):
        """Path of the cached picture, or None (and a download is queued if it isn't already)."""
        p = self.path(cid)
        if os.path.exists(p): return p
        st = self.state.get(cid)
        if st is None or (st[0] == "fail" and time.time() - st[1] > 30):
            self.state[cid] = ("queued", time.time()); self.q.put(cid)
        return None

    def failed(self, cid):
        return self.state.get(cid, ("",))[0] == "fail"

    def discard(self, cid):
        try: os.remove(self.path(cid))
        except OSError: pass
        self.state[cid] = ("fail", time.time())

    def _work(self):
        while True:
            cid = self.q.get()
            p = self.path(cid)
            try:
                os.makedirs(IMG_DIR, exist_ok=True)
                req = urllib.request.Request(self.url.format(id=cid), headers={"User-Agent": "hstrack"})
                with urllib.request.urlopen(req, timeout=15) as r: data = r.read()
                if not data.startswith(b"\x89PNG"): raise ValueError("not a PNG")
                with open(p + ".part", "wb") as f: f.write(data)
                os.replace(p + ".part", p)
                self.state[cid] = ("ok", time.time())
            except Exception:
                self.state[cid] = ("fail", time.time())


# ---------------------------------------------------------------- views
def label(e, names):
    return names.get(e["card"]) or e["name"] or e["card"] or "?"


def summary(g, names, db, deck, learned):
    me = g.me
    ents = list(g.ents.values())
    mine = [e for e in ents if me and e["ctrl"] == me]
    opp = [e for e in ents if me and e["ctrl"] == 3 - me]
    count = lambda es, z: sum(e["zone"] == z for e in es)
    by_id = {cid: k for k, d in deck.items() for cid in d["ids"]}

    def key_of(e):
        k = by_id.get(e["card"])
        if k is None:
            nk = norm(label(e, names))
            k = nk if nk in deck else None
        return k

    # copies of each listed card that have left your starting deck so far
    drawn, changed = Counter(), False
    for e in mine:
        if e["init"] and e["left_deck"] and e["card"]:
            k = key_of(e)
            if k: drawn[k] += 1
    for k, v in drawn.items():                      # remember the most copies ever seen of a card
        if v > learned.get(k, 0): learned[k] = v; changed = True
    # copy counts: your best estimate, never below what has been seen; trimmed if the total exceeds the deck size
    start_n = sum(1 for e in mine if e["init"] and (e["zone"] == "DECK" or e["left_deck"]))
    est = {k: max(d["n"], learned.get(k, 0)) for k, d in deck.items()}
    over = sum(est.values()) - start_n if start_n else 0
    while over > 0:
        spare = [k for k, d in deck.items() if not d["exact"] and est[k] > max(1, learned.get(k, 0))]
        if not spare: break
        k = max(spare, key=lambda k: (est[k] - learned.get(k, 0), k))
        est[k] -= 1; over -= 1
    rem = {k: est[k] - drawn[k] for k in deck}
    meta = {k: (d["name"], d["cost"], min(d["ids"]) if d["ids"] else None) for k, d in deck.items()}
    for e in mine:                                  # cards shuffled into / created in your deck mid-game
        if not e["init"] and e["zone"] == "DECK" and e["card"]:
            k = key_of(e) or "+" + norm(label(e, names))
            rem[k] = rem.get(k, 0) + 1
            meta.setdefault(k, (label(e, names), (db.get(e["card"]) or [0, None])[1], e["card"]))
    deck_n = count(mine, "DECK")
    rows = [(meta[k][1], meta[k][0], n, meta[k][2]) for k, n in rem.items() if n > 0]
    unknown = deck_n - sum(r[2] for r in rows) if me and deck else 0
    if unknown > 0: rows.append((None, "(unknown)", unknown, None))
    rows.sort(key=lambda r: (99 if r[0] is None else r[0], norm(r[1])))
    total = deck_n if me else sum(r[2] for r in rows)
    played = {}
    for e in opp:
        if e["played"] and e["card"]:
            p = played.setdefault(label(e, names), [0, e["card"]]); p[0] += 1
    return dict(turn=g.turn, me=me, mode=g.mode, changed=changed, deck_n=deck_n, hand_n=count(mine, "HAND"),
                total=total, size=total or 1, rows=rows, opp_deck=count(opp, "DECK"), opp_hand=count(opp, "HAND"),
                hand=sorted(label(e, names) for e in mine if e["zone"] == "HAND" and e["card"]),
                drawn=Counter(label(e, names) for e in mine if e["left_deck"] and e["zone"] != "DECK" and e["card"]),
                opp=sorted((nm, p[0], p[1]) for nm, p in played.items()))


def short(nm):
    return nm if len(nm) <= NAME_W else nm[:NAME_W - 1] + "\u2026"


def fmt_rows(s):
    w = min(NAME_W, max([len(r[1]) for r in s["rows"]] or [0]))
    return [f"{'-' if c is None else c:>2} {short(nm):<{w}} {n}x {100 * n // s['size']:>3}%" for c, nm, n, cid in s["rows"]]


def text_view(s, deck, src):
    out = [f"turn {s['turn']}   you = player {s['me'] or '?'}   {s['mode'] or 'no game yet'}",
           f"you: deck {s['deck_n']} hand {s['hand_n']}    opp: deck {s['opp_deck']} hand {s['opp_hand']}",
           "", "HAND: " + (", ".join(s["hand"]) or "-"), ""]
    if deck:
        out += [f"DECK ({s['total']} cards left)  [{src}]"] + ["  " + r for r in fmt_rows(s)]
    else:
        out += [f"DRAWN ({sum(s['drawn'].values())})  [{src}]"] + [f"  {n}x {c}" for c, n in sorted(s["drawn"].items())]
    out += ["", f"OPPONENT PLAYED ({sum(n for _, n, _ in s['opp'])})"]
    out += [f"  {n}x {nm}" for nm, n, cid in s["opp"]]
    return "\n".join(out)


def overlay_lines(s, deck, src, err, show_opp):
    """[(text, card id or None)] - one overlay row each; rows with a card id show its picture on hover."""
    if not deck:
        if src.startswith("arena"):
            return [(t, None) for t in ("arena deck not found", "yet. It appears in", "Arena.log once you are", "on the Arena screen.")]
        return [(t, None) for t in textwrap.wrap(err, 24) + ([""] if err else [])
                + ["no deck loaded.", "Copy it in Hearthstone,", "then click 'paste'."]]
    out = [(f"{s['total']} left  t{s['turn']}  {src}", None)]
    out += [(txt, r[3]) for txt, r in zip(fmt_rows(s), s["rows"])]
    if err: out += [("", None)] + [(t, None) for t in textwrap.wrap(err, 24)]
    if show_opp:
        out += [("", None), ("opp played:", None)] + [(f" {n}x {short(nm)}", cid) for nm, n, cid in s["opp"]]
    return out


def run_overlay(a, fol, db, names, state, arena):
    try:
        import tkinter as tk
        from tkinter import font as tkfont
    except ImportError:
        sys.exit("tkinter is missing - on Void: sudo xbps-install -S python3-tkinter")
    BG, HI, FG, DIM = "#0d1117", "#1f2a37", "#e6edf3", "#8b949e"
    try: root = tk.Tk()
    except tk.TclError as ex: sys.exit(f"can't open a window: {ex}")
    root.title("hstrack")
    root.overrideredirect(True)            # no title bar; drag the header to move
    root.attributes("-topmost", True)
    try: root.attributes("-alpha", a.alpha)   # needs a compositor (xfwm4: Window Manager Tweaks)
    except tk.TclError: pass
    root.configure(bg=BG)
    root.geometry(a.pos)
    fnt = tkfont.nametofont("TkFixedFont").copy()
    fnt.configure(size=a.size)
    images = None if a.no_images else Images(a.img_url)
    pool, shown, photos = [], [0], {}
    hover = {"row": None, "cid": None, "hide": None}

    # ---- card picture popup (a second borderless window beside the overlay)
    popup = tk.Toplevel(root)
    popup.overrideredirect(True)
    popup.attributes("-topmost", True)
    popup.configure(bg=BG)
    popup.withdraw()
    pic = tk.Label(popup, bg=BG, fg=FG, font=fnt, padx=6, pady=4)
    pic.pack()

    def hide_card():
        hover["cid"] = None
        popup.withdraw()

    def draw_card():
        row, cid = hover["row"], hover["cid"]
        if row is None or cid is None: return
        path, ph = images.want(cid), None
        if path:
            try: ph = photos.get(cid) or photos.setdefault(cid, tk.PhotoImage(file=path))
            except tk.TclError: images.discard(cid)
        if ph: pic.config(image=ph, text="")
        else: pic.config(image="", text=f"no picture for {cid}" if images.failed(cid) else "loading picture...")
        popup.update_idletasks()
        w, h = popup.winfo_reqwidth(), popup.winfo_reqheight()
        sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
        x = root.winfo_rootx() + root.winfo_width() + 6          # right of the overlay, else left
        if x + w > sw: x = max(0, root.winfo_rootx() - w - 6)
        y = max(0, min(row.winfo_rooty() + row.winfo_height() // 2 - h // 2, sh - h))
        popup.geometry(f"+{x}+{y}")
        popup.deiconify(); popup.lift()
        if not ph and not images.failed(cid): root.after(200, poll, row, cid)   # still downloading

    def poll(row, cid):
        if hover["row"] is row and hover["cid"] == cid: draw_card()

    def show_card(row):
        if images is None or not row.cid: hide_card(); return
        hover["cid"] = row.cid
        draw_card()

    def enter(row):
        if hover["hide"]: root.after_cancel(hover["hide"]); hover["hide"] = None
        hover["row"] = row
        if row.cid: row.config(bg=HI)
        show_card(row)

    def leave(row):
        row.config(bg=BG)
        if hover["row"] is row: hover["row"] = None
        hover["hide"] = root.after(80, hide_card)

    # ---- window: header bar + one label per row
    grab = {}
    def start(e): grab["dx"], grab["dy"] = e.x_root - root.winfo_x(), e.y_root - root.winfo_y()
    def move(e): root.geometry(f"+{e.x_root - grab['dx']}+{e.y_root - grab['dy']}")

    def paste():
        try: text = root.clipboard_get()
        except tk.TclError:
            state["err"] = "clipboard is empty"; refresh(); return
        try: state["deck"] = parse_deck(text, db)
        except ValueError as ex:
            state["err"] = str(ex); refresh(); return
        state["err"] = ""
        save_deck(text)
        refresh()

    bar = tk.Frame(root, bg=BG); bar.pack(fill="x")
    title = tk.Label(bar, text="hstrack", fg=DIM, bg=BG, font=fnt); title.pack(side="left", padx=4)
    for txt, cmd in (("x", root.destroy), ("paste", paste)):
        b = tk.Label(bar, text=txt, fg=DIM, bg=BG, font=fnt, cursor="hand2"); b.pack(side="right", padx=4)
        b.bind("<Button-1>", lambda e, c=cmd: c())
    box = tk.Frame(root, bg=BG); box.pack(fill="both")
    for w in (bar, title, box):
        w.bind("<ButtonPress-1>", start); w.bind("<B1-Motion>", move)

    def make_row():
        lab = tk.Label(box, text="", justify="left", anchor="w", fg=FG, bg=BG, font=fnt, padx=5, pady=0)
        lab.cid = None
        lab.bind("<Enter>", lambda e, r=lab: enter(r)); lab.bind("<Leave>", lambda e, r=lab: leave(r))
        lab.bind("<ButtonPress-1>", start); lab.bind("<B1-Motion>", move)
        return lab

    def set_lines(lines):
        while len(pool) < len(lines): pool.append(make_row())
        for lab, (text, cid) in zip(pool, lines):
            if lab.cget("text") != text: lab.config(text=text)
            lab.cid = cid
        if len(lines) != shown[0]:
            for i, lab in enumerate(pool):
                if i < len(lines): lab.pack(fill="x")
                else: lab.pack_forget()
            shown[0] = len(lines)

    def refresh():
        deck, src, learned = choose_deck(fol.g, state, arena, fol.path)
        s = summary(fol.g, names, db, deck, learned)
        if s["changed"]: save_learned(state["learned"])
        lines = overlay_lines(s, deck, src, state["err"], a.opp)
        if fol.msg: lines += [("", None)] + [(t, None) for t in textwrap.wrap(fol.msg.replace("\n", " "), 24)]
        set_lines(lines)
        if images:
            for r in s["rows"]:
                if r[3]: images.want(r[3])                     # fetch deck pictures ahead of hovering
        row = hover["row"]
        if row is not None and row.cid != hover["cid"]: show_card(row)

    def tick():
        if fol.poll(): refresh()
        root.lift()                        # stay above the game window
        if hover["cid"]: popup.lift()
        root.after(500, tick)

    refresh(); tick()
    try: root.mainloop()
    except KeyboardInterrupt: pass


def main():
    ap = argparse.ArgumentParser(description="Tiny Hearthstone tracker (follows Power.log)")
    ap.add_argument("--prefix", default=os.environ.get("HS_PREFIX", "~/Games/battlenet"),
                    help="Wine prefix containing Hearthstone (default: $HS_PREFIX or ~/Games/battlenet)")
    ap.add_argument("--log", help="read this Power.log instead of searching the prefix")
    ap.add_argument("--deck", help="deck file or deck code for non-arena games (default: the last deck you pasted)")
    ap.add_argument("-o", "--overlay", action="store_true", help="show the always-on-top overlay window")
    ap.add_argument("--pos", default="+20+120", help="overlay position, e.g. +20+120 (drag the header to move)")
    ap.add_argument("--alpha", type=float, default=0.88, help="overlay opacity 0.2-1.0")
    ap.add_argument("--size", type=int, default=10, help="overlay font size")
    ap.add_argument("--opp", action="store_true", help="also list opponent's played cards in the overlay")
    ap.add_argument("--no-images", action="store_true", help="don't show card pictures on hover")
    ap.add_argument("--img-url", default=IMG_URL, help="card picture URL template with {id}")
    ap.add_argument("--once", action="store_true", help="terminal mode: parse once, print, exit")
    ap.add_argument("--setup", action="store_true", help="make Hearthstone write Power.log, then exit")
    a = ap.parse_args()
    prefix = os.path.expanduser(a.prefix)
    if a.setup: return setup(prefix)

    db = load_db()
    names = {k: v[0] for k, v in db.items()}
    state = {"deck": {}, "err": "", "learned": load_learned()}
    src = a.deck if a.deck else None
    if src and os.path.isfile(src):
        with open(src, encoding="utf-8") as f: src = f.read()
    elif not src and os.path.isfile(DECK_CACHE):
        with open(DECK_CACHE, encoding="utf-8") as f: src = f.read()
    if src:
        try: state["deck"] = parse_deck(src, db)
        except ValueError as ex: print(f"deck: {ex}", file=sys.stderr)

    fol, arena = Follower(a, prefix), ArenaSource(db)
    if a.overlay: return run_overlay(a, fol, db, names, state, arena)
    while True:
        if fol.poll():
            if fol.msg: print(fol.msg, file=sys.stderr)
            else:
                deck, how, learned = choose_deck(fol.g, state, arena, fol.path)
                s = summary(fol.g, names, db, deck, learned)
                if s["changed"]: save_learned(state["learned"])
                if sys.stdout.isatty(): sys.stdout.write("\033[2J\033[H")
                print(text_view(s, deck, how), flush=True)
        if a.once: break
        time.sleep(0.5)


if __name__ == "__main__":
    try: main()
    except KeyboardInterrupt: pass
